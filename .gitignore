# Ignore Node dependencies installed for tests
aegir*
node_modules/

# Ignore test coverage reports
coverage/
.nyc_output/

# Ignore Cypress/Playwright or other e2e artifacts
videos/
screenshots/
report/

# Ignore log files
*.log

# Ignore locally generated environment or config files
.env*
*.local.*

# Ignore TypeScript build info
tsconfig.*.tsbuildinfo

# Claude Code
.claude/
CLAUDE.md

# Screenshots de prueba
chatbot-*.png

# Capturas sueltas generadas por scripts de verificación manual (deben ir a tests/screenshots/)
/*.png
/*.jpg
/*.jpeg
verify-*.png
vcheck*.png

# Builds
build/
dist/

# Documentación: solo README.md en raíz; el resto va en docs/
/*.md
!/README.md
/*.txt
# Notas de sesión / reportes de trabajo (solo locales)
docs/notas/

# Salidas sueltas de scripts / diagnósticos
/*.html

# Plugins / config local de herramientas de IA
.claude-plugin/

# Sistema operativo / editores
.DS_Store
Thumbs.db
.vscode/
.idea/
